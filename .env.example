# Copy to .env and fill in. .env is gitignored — never commit it.

# Solana RPC. Free-tier Helius works: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Any Solana RPC URL works; Helius-specific features (enhanced tx history) are used when available.
SOLANA_RPC_URL=

# Optional. When set, the scanner/market data uses Birdeye in addition to DexScreener.
BIRDEYE_API_KEY=

# Optional. Only needed if your Jupiter endpoint requires a key (api.jup.ag); lite-api does not.
JUPITER_API_KEY=

# Currently unused: the RugCheck endpoints the bot calls are public.
RUGCHECK_API_KEY=

# LIVE TRADING ONLY. Base58 secret key of the trading wallet.
# Never read in paper mode. Never logged. Use a dedicated wallet holding only trading funds.
WALLET_PRIVATE_KEY=
