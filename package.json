{
  "name": "memecoin-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Solana memecoin trading bot (paper trading by default)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "bot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bot": "tsx src/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.7",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
